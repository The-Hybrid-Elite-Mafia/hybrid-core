#include "setup_resource.h"
#include <winver.h>
IDI_SETUP ICON "../studio/assets/hybridcore.ico"
IDR_PAYLOAD_APP RCDATA "../build-win/HybridCore.exe"
IDR_LIC_GPL RCDATA "../build-win/LICENSE.txt"
IDR_LIC_NOTICES RCDATA "../build-win/THIRD-PARTY-NOTICES.txt"
IDR_LIC_ASIO RCDATA "../build-win/ASIO-SDK-LICENSE.txt"
1 24 "setup.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,1,0,0
PRODUCTVERSION 2,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Hybrid Elite Mafia"
      VALUE "FileDescription", "THE HYBRID CORE 2.0 Setup"
      VALUE "FileVersion", "2.1.0"
      VALUE "ProductName", "THE HYBRID CORE"
      VALUE "ProductVersion", "2.1.0"
      VALUE "OriginalFilename", "HybridCore-Setup.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
